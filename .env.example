# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables (never commit real values).

# --- Server (API) ---
# MongoDB Atlas connection string (free M0 cluster is enough).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Random string of 32+ characters used to sign admin sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated Google account emails allowed into /admin.
ADMIN_EMAILS=you@gmail.com

# Sign-in methods (set at least one):
# Firebase Authentication (Google) works automatically when the VITE_APP_* Firebase web
# config below is set; FIREBASE_PROJECT_ID optionally overrides the project id the server checks.
# Google OAuth "Web application" client id; add your site URL(s) as authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Optional password login (handy for local dev). Leave empty to disable.
ADMIN_PASSWORD=

# Enables POST /api/sync and GET /api/sync/export for the LKH sync (docs/lkh-sync.md).
# 32+ random characters; leave empty to disable.
SYNC_TOKEN=

# --- Client (optional) ---
# EmailJS: if set, contact-form messages are also emailed to you.
# Messages are always stored in the database and shown under Admin → Messages.
VITE_SERVICE_ID=
VITE_TEMPLATE_ID_CONTACT_US=
VITE_PUBLIC_KEY=

# --- Firebase web config: admin Google sign-in, and the one-time migration ---
VITE_APP_API_KEY=
VITE_APP_AUTH_DOMAIN=
VITE_APP_PROJECT_ID=
VITE_APP_STORAGE_BUCKET=
VITE_APP_APP_ID=

# Optional: the content value of Google Search Console's "HTML tag" verification
# (<meta name="google-site-verification" content="...">). Added to the home page at build time.
GOOGLE_SITE_VERIFICATION=
